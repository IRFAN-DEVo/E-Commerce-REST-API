# =====================================================================
# DjangoMart - React Frontend Environment Template
#
# Location: frontend/.env
#
# SECURITY WARNING:
# Vite exposes ALL variables prefixed with 'VITE_' to the client-side
# JavaScript bundle in the browser.
# NEVER put database credentials, SMTP passwords, Django SECRET_KEY,
# or server private API keys in this file.
# =====================================================================

# In development with Vite proxy (vite.config.js), '/api/v1' routes directly to Django backend:
VITE_API_BASE_URL=/api/v1

# For cross-origin production setups where the React frontend and Django backend
# are hosted on different domains, provide the absolute URL:
# VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
