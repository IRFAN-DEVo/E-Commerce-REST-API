# =====================================================================
# DjangoMart - Backend Environment Configuration Template
#
# CANONICAL LOCATION:
# The primary backend configuration file should be located at the
# PROJECT ROOT:
#   <project_root>/.env  (e.g., ../../.env relative to this file)
#
# This file in src/commerce/ is maintained for backward compatibility.
# If both exist, the root .env takes precedence.
#
# DO NOT commit real secrets or credentials to version control.
# =====================================================================

# --- Django Core Settings ---
SECRET_KEY=your-production-secret-key-here-min-50-characters-randomized
DEBUG=False
ALLOWED_HOSTS=example.com,api.example.com,127.0.0.1,localhost

# --- Email / SMTP Settings ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=server-alerts@example.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-smtp-or-gmail-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

# Gmail SMTP Guide:
# 1. Enable 2-Step Verification on your Google Account.
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Put that App Password into EMAIL_HOST_PASSWORD.
# 4. Use port 587 with EMAIL_USE_TLS=True and EMAIL_USE_SSL=False.

# --- Payment Gateways ---
STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
# Razorpay
# Use test mode credentials for local development and testing (e.g. rzp_test_...).
# Generate test keys in Razorpay Dashboard > Settings > API Keys.
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- CORS & CSRF ---
CORS_ALLOWED_ORIGINS=https://example.com,https://admin.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://admin.example.com

# --- Production Security ---
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True

# HSTS (HTTP Strict Transport Security)
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Reverse proxy header
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO

# --- Database ---
# Production PostgreSQL:
# DATABASE_URL=postgres://djangomart:password@localhost:5432/djangomart_db
# Local SQLite default is used when DATABASE_URL is unset.
# ALLOW_SQLITE_IN_PRODUCTION=False
