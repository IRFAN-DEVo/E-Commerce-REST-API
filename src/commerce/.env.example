# =====================================================================
# DjangoMart - Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# DO NOT commit real secrets or credentials to version control.
# =====================================================================

# --- Django Core Settings ---
SECRET_KEY=your-production-secret-key-here-min-50-characters-randomized
DEBUG=False
ALLOWED_HOSTS=example.com,api.example.com,127.0.0.1,localhost

# --- Email / SMTP Settings ---
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-smtp-api-key-here
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# --- Payment Gateways ---
STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret

RAZORPAY_KEY_ID=rzp_live_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# --- CORS & CSRF ---
CORS_ALLOWED_ORIGINS=https://example.com,https://admin.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://admin.example.com

# --- Production Security ---
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True

# HSTS (HTTP Strict Transport Security)
# Start with a short value (e.g. 300) during initial deployment.
# Increase to 31536000 (1 year) once HTTPS is confirmed working.
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Reverse proxy header — set to the header your proxy uses to indicate HTTPS.
# Django expects the WSGI request.META key name (HTTP_X_FORWARDED_PROTO).
# Leave blank if not behind a TLS-terminating proxy.
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO

# --- Database ---
# Uncomment and configure for production (PostgreSQL recommended).
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=postgres://djangomart:password@localhost:5432/djangomart_db
