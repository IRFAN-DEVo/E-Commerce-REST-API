# =====================================================================
# DjangoMart - Environment Configuration Template
#
# CANONICAL BACKEND LOCATION:
# Copy this file to .env at the PROJECT ROOT:
#   cp .env.example .env
#
# DO NOT commit real secrets or credentials to version control.
# =====================================================================

# --- Django Core Settings ---
# Set a unique, cryptographically random key in production (min 50 chars).
SECRET_KEY=your-production-secret-key-here-min-50-characters-randomized

# Set DEBUG=False in production. Defaults to True if omitted for local dev.
DEBUG=False

# Comma-separated list of fully qualified domain names and IP addresses.
ALLOWED_HOSTS=example.com,api.example.com,127.0.0.1,localhost

# --- Email / SMTP Settings ---
# Used for email verification OTPs, password-reset OTPs, and system alerts.
#
# Option A: Local Development (Console Backend)
# Prints sent emails directly to the terminal; no external network calls.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
#
# Option B: Real SMTP Delivery (e.g., Gmail, SendGrid, Amazon SES)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=server-alerts@example.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-smtp-or-gmail-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

# Gmail SMTP Configuration Guide:
# 1. Enable 2-Step Verification in your Google Account settings.
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Set EMAIL_HOST_PASSWORD to that 16-character code (not your personal password).
# 4. Use port 587 with EMAIL_USE_TLS=True and EMAIL_USE_SSL=False.
#    (Or port 465 with EMAIL_USE_TLS=False and EMAIL_USE_SSL=True).
# Note: EMAIL_USE_TLS and EMAIL_USE_SSL are mutually exclusive.

# --- Payment Gateways ---
# Stripe
STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret

# Razorpay
# Use test mode credentials for local development and testing (e.g. rzp_test_...).
# Generate test keys in Razorpay Dashboard > Settings > API Keys.
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- SMS & Phone Verification ---
# Provider options:
#   console - Local development only; prints SMS to stdout (fails safe if DEBUG=False)
#   dummy   - In-memory mock for automated tests
#   twilio  - Twilio SMS API
#   msg91   - MSG91 Transactional Flow SMS API
SMS_PROVIDER=console

# Twilio Configuration (if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=

# MSG91 Configuration (if SMS_PROVIDER=msg91)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=DJMART
MSG91_TEMPLATE_ID=your_msg91_flow_or_template_id

# Phone OTP Security & Challenge Parameters
# Independent high-entropy server secret for HMAC-SHA256 OTP hashing
OTP_HMAC_SECRET=your-dedicated-high-entropy-otp-secret-key-min-32-chars
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# --- CORS & CSRF ---
# Comma-separated origins allowed to make cross-origin requests.
CORS_ALLOWED_ORIGINS=https://example.com,https://admin.example.com

# Comma-separated trusted origins for CSRF protection.
CSRF_TRUSTED_ORIGINS=https://example.com,https://admin.example.com

# --- Production Security (HTTPS / Cookies) ---
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True

# HSTS (HTTP Strict Transport Security)
# Start with a short value (e.g. 300) during initial deployment.
# Increase to 31536000 (1 year) once HTTPS is confirmed working.
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Reverse proxy header — set to the header your proxy uses to indicate HTTPS.
# Django expects the WSGI request.META key name (HTTP_X_FORWARDED_PROTO).
# Leave blank if not behind a TLS-terminating proxy.
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO

# --- Database ---
# For production (PostgreSQL recommended):
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=postgres://djangomart:password@localhost:5432/djangomart_db
#
# For local development:
# If DATABASE_URL is unset, Django automatically uses local SQLite (db.sqlite3).
# Set ALLOW_SQLITE_IN_PRODUCTION=True only if intentionally using SQLite with DEBUG=False.
# ALLOW_SQLITE_IN_PRODUCTION=False
